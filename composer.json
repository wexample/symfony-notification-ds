{
  "name": "wexample/symfony-notification-ds",
  "description": "Design-system screens for symfony-notification: the inbox, the preferences, the page an unsubscribe link opens",
  "version": "2.0.3",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyNotificationDs\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-notification": ">=2.1.0",
    "wexample/symfony-design-system": ">=37.0.0",
    "wexample/symfony-forms": ">=13.0.0",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-loader": ">=23.1.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}